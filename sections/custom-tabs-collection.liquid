<div class="collection-tabs-section universal-tabs">
  {% if section.settings.title != blank %}
    <div class="page-width">
      <div class="section-header">
        <h2 class="section-header__title">{{ section.settings.title }}</h2>
        {% if section.settings.subtitle != blank %}
          <p class="section-header__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <ul class="tabs tab-buttons page-width" role="tablist">
    {% for block in section.blocks %}
      {% assign collection = collections[block.settings.collection] %}
      <li
        class="tab-item tab-btn {% if forloop.first %}active{% endif %}"
        data-target="#tab-{{ forloop.index }}"
        role="tab"
      >
        {{ block.settings.title | default: collection.title }}
      </li>
    {% endfor %}
  </ul>

  <div class="tab-contents page-width">
    {% for block in section.blocks %}
      {% assign collection = collections[block.settings.collection] %}
      <div
        class="tab-content grid grid--uniform {% if forloop.first %}active{% endif %}"
        id="tab-{{ forloop.index }}"
      >
        {% for product in collection.products limit: 8 %}
          {%- render 'product-grid-item',
            product: product,
            per_row: 4,
            quick_shop_enable: settings.quick_shop_enable,
           
          -%}
        {% endfor %}
        {% if section.settings.show_view_all %}
          <div class="section-footer" style="text-align: end;">
            <a href="{{ collection.url }}" class="btn btn--secondary btn--small section-header__link">{{ 'collections.general.all_of_collection' | t }}</a>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Tabbed Collections",
  "class": "index-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "What's New"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' link",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Tab title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed Collections"
    }
  ]
}
{% endschema %}
