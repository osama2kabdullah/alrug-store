{% section 'collection-header' %}
<div id="CollectionAjaxResult" class="collection-content page-layout-2columns-left">
  <div id="CollectionAjaxContent">
    <div class="page-width page-main">
      <div class="columns grid">
        <div class="category-view page-width page-main">
          <h1 class="category-title">{{ collection.title }}</h1>
          {% if collection.description != blank %}
            <div class="rte description">
              {{ collection.description }}
            </div>
            <hr class="hr--clear hr--small">
          {% endif %}
        </div>
        <div class="sidebar sidebar-main">
          {% section 'collection-sidebar' %}
        </div>
        <div class="column main">
          {% section 'collection-promotions' %}
          <div class="collection-grid__wrapper">
            {% section 'collection-template' %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
