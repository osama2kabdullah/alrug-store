<style>
  .custom-testimonials-page .page-content {
      padding-top: 0px;
  }

  .custom-testimonials-page .reviews {
      display: grid;
      gap: 20px;
  }

  .custom-testimonials-page .review h4{
      font-size: large;
      letter-spacing: normal;
      font-family: var(--typeBasePrimary), var(--typeBaseFallback);
      padding-top: 10px;
  }

  .custom-testimonials-page .review {
      display: grid;
      grid-template-columns: 200px auto;
      padding-top: 20px;
      gap: 15px;
      border-top: 1px solid #e1e1e1;
  }

  .custom-testimonials-page .stars {
      color: #f8b400;
      font-size: 30px;
      letter-spacing: 2px;
  }

  .custom-testimonials-page .pagination {
      display: inline-flex;
      list-style: none;
      padding: 0;
      margin: 30px 0;
      gap: 6px;
  }

  .custom-testimonials-page .page-item .page-link {
      display: block;
      padding: 8px 14px;
      font-size: 15px;
      color: #444;
      background: #f7f7f7;
      border: 1px solid #ddd;
      border-radius: 6px;
      text-decoration: none;
      transition: all 0.25s ease;
  }

  .custom-testimonials-page .page-item .page-link:hover {
      background: #eaeaea;
      border-color: #bbb;
      color: #000;
  }

  .custom-testimonials-page .page-item.active .page-link {
      background: #000;
      border-color: #000;
      color: #fff;
      cursor: default;
  }

  .custom-testimonials-page .page-item.disabled .page-link {
      opacity: 0.6;
      cursor: not-allowed;
      pointer-events: none;
  }

  /* Responsive */
  @media (max-width: 720px) {
      .custom-testimonials-page .review {
          grid-template-columns: 1fr;
      }
  }
</style>

<div class="page-width page-width--narrow page-content">
  <div class="rte rte--nomargin">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Custom Testimonials Page",
  "tag": "section",
  "class": "custom-testimonials-page"
}
{% endschema %}
