{%- unless grid_item_width -%}
  {%- assign grid_item_width = 'small--one-half medium-up--one-third' -%}
{%- endunless -%}

{%- unless background_position -%}
  {%- assign background_position = 'center center' -%}
{%- endunless -%}

{%- if block.settings.title != blank -%}
  {%- assign title_output = block.settings.title -%}
{%- else -%}
  {%- if collection.empty? -%}
    {%- assign title_output = 'home_page.onboarding.collection_title' | t -%}
  {% elsif collection_title %}
    {%- assign title_output = collection_title -%}
  {%- else -%}
    {%- assign title_output = collection.title | escape -%}
  {%- endif -%}
{%- endif -%}

{%- if block.settings.subtitle != blank -%}
  {%- assign subtitle_output = block.settings.subtitle -%}

{%- endif -%}

{% assign titleid = title_output | split: " " | first %}
 <li role="presentation" class="{%- if index == 1 -%} active {%- endif -%}"><a href="#{{titleid}}" aria-controls="home" role="tab" data-toggle="tab">{{ title_output }}</a></li>
   


 

